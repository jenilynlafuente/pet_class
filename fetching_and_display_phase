class Pet:
    def __init__(self):
        
        self.__name = ""
        self.__animal_type = ""
        self.__age = 0

    def set_name(self, name: str):
        self.__name = str(name)

    def set_animal_type(self, animal_type: str):
        self.__animal_type = str(animal_type)

    def set_age(self, age: int):

        self.__age = int(age)

    def get_name(self) -> str:
        return self.__name

    def get_animal_type(self) -> str:
        return self.__animal_type

    def get_age(self) -> int:
        return self.__age

def main():
    print("[INFO] Initializing Pet Data Entry Program...")
    print("-" * 50)

    my_pet = Pet()

    user_name = input("Enter your pet's name: ")
    user_type = input("Enter your pet's animal type (e.g., Dog, Cat, Bird): ")
    user_age = int(input("Enter your pet's age: "))

    print("-" * 50)
    print("[INFO] Storing data fields securely using object mutators...")

    my_pet.set_name(user_name)
    my_pet.set_animal_type(user_type)
    my_pet.set_age(user_age)

    print("[INFO] Retrieving and displaying telemetry data...")
    print("-" * 50)

    print("OBJECT INSTANCE DATA SUMMARY:")
    print(f" -> Pet Name         : {my_pet.get_name()}")
    print(f" -> Animal Species   : {my_pet.get_animal_type()}")
    print(f" -> Registered Age   : {my_pet.get_age()} year(s) old")
    print("-" * 50)
    print("[INFO] Execution terminated successfully.")


if __name__ == "__main__":
    main()
